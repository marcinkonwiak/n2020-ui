{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "n2020",
  "homepage": "https://ui.n2020.com",
  "items": [
    {
      "name": "theme",
      "type": "registry:theme",
      "title": "Theme",
      "description": "Colour tokens, fonts, and scrollbar styles for n2020 components.",
      "dependencies": [
        "@fontsource-variable/geist",
        "@fontsource-variable/geist-mono",
        "@fontsource/instrument-serif"
      ],
      "cssVars": {
        "theme": {
          "font-heading": "var(--font-sans)",
          "font-sans": "\"Geist Variable\", sans-serif",
          "font-display": "\"Instrument Serif\", ui-serif, Georgia, serif",
          "font-mono": "\"Geist Mono Variable\", ui-monospace, monospace",
          "radius-sm": "calc(var(--radius) * 0.6)",
          "radius-md": "calc(var(--radius) * 0.8)",
          "radius-lg": "var(--radius)",
          "radius-xl": "calc(var(--radius) * 1.4)",
          "radius-2xl": "calc(var(--radius) * 1.8)",
          "radius-3xl": "calc(var(--radius) * 2.2)",
          "radius-4xl": "calc(var(--radius) * 2.6)"
        },
        "light": {
          "background": "#f2f0e9",
          "foreground": "#16163f",
          "card": "#f8f6f0",
          "card-foreground": "#16163f",
          "popover": "#f8f6f0",
          "popover-foreground": "#16163f",
          "primary": "#2b2bf5",
          "primary-foreground": "#ffffff",
          "secondary": "#e7e5dd",
          "secondary-foreground": "#16163f",
          "muted": "#e7e5dd",
          "muted-foreground": "#62627f",
          "accent": "#e7e5dd",
          "accent-foreground": "#16163f",
          "destructive": "#d43a25",
          "border": "rgb(22 22 63 / 14%)",
          "input": "rgb(22 22 63 / 20%)",
          "ring": "#2b2bf5",
          "chart-1": "#16163f",
          "chart-2": "#2b2bf5",
          "chart-3": "#8a8af5",
          "chart-4": "#4a4ad0",
          "chart-5": "#b4b4f4",
          "sidebar": "#f2f0e9",
          "sidebar-foreground": "#16163f",
          "sidebar-primary": "#2b2bf5",
          "sidebar-primary-foreground": "#ffffff",
          "sidebar-accent": "#e4e2ea",
          "sidebar-accent-foreground": "#16163f",
          "sidebar-border": "rgb(22 22 63 / 14%)",
          "sidebar-ring": "#2b2bf5",
          "radius": "0rem",
          "scrollbar-thumb": "rgb(22 22 63 / 30%)",
          "scrollbar-thumb-hover": "var(--ring)",
          "scrollbar-track": "transparent"
        },
        "dark": {
          "background": "#0b0c14",
          "foreground": "#ecebe6",
          "card": "#101119",
          "card-foreground": "#ecebe6",
          "popover": "#14151f",
          "popover-foreground": "#ecebe6",
          "primary": "#3232c0",
          "primary-foreground": "#ffffff",
          "secondary": "#191a25",
          "secondary-foreground": "#ecebe6",
          "muted": "#191a25",
          "muted-foreground": "#9c9cab",
          "accent": "#191a25",
          "accent-foreground": "#ecebe6",
          "destructive": "#ff6a52",
          "border": "rgb(236 235 230 / 12%)",
          "input": "rgb(236 235 230 / 18%)",
          "ring": "#7c7cf8",
          "chart-1": "#ecebe6",
          "chart-2": "#5a5aff",
          "chart-3": "#a8a8ff",
          "chart-4": "#3d3dd8",
          "chart-5": "#26267a",
          "sidebar": "#0b0c14",
          "sidebar-foreground": "#ecebe6",
          "sidebar-primary": "#3232c0",
          "sidebar-primary-foreground": "#ffffff",
          "sidebar-accent": "#191a25",
          "sidebar-accent-foreground": "#ecebe6",
          "sidebar-border": "rgb(236 235 230 / 12%)",
          "sidebar-ring": "#7c7cf8",
          "scrollbar-thumb": "rgb(236 235 230 / 30%)"
        }
      },
      "css": {
        "@import \"@fontsource-variable/geist\"": {},
        "@import \"@fontsource-variable/geist-mono\"": {},
        "@import \"@fontsource/instrument-serif/400.css\"": {},
        "@layer base": {
          "*": {
            "@apply border-border outline-ring/50": {}
          },
          "body": {
            "@apply bg-background text-foreground": {}
          },
          "html": {
            "@apply font-sans": {}
          },
          "@media (forced-colors: none)": {
            "@supports not selector(::-webkit-scrollbar)": {
              "*": {
                "scrollbar-width": "thin",
                "scrollbar-color": "var(--scrollbar-thumb) var(--scrollbar-track)"
              }
            },
            "*::-webkit-scrollbar": {
              "width": "9px",
              "height": "9px"
            },
            "*::-webkit-scrollbar-track, *::-webkit-scrollbar-corner": {
              "background": "var(--scrollbar-track)"
            },
            "*::-webkit-scrollbar-thumb": {
              "border": "2px solid transparent",
              "border-radius": "0",
              "background": "var(--scrollbar-thumb)",
              "background-clip": "padding-box"
            },
            "*::-webkit-scrollbar-thumb:hover, *::-webkit-scrollbar-thumb:active": {
              "background-color": "var(--scrollbar-thumb-hover)"
            }
          }
        },
        "@utility scrollbar-thin": {
          "@media (forced-colors: none)": {
            "@supports selector(::-webkit-scrollbar)": {
              "scrollbar-width": "auto"
            }
          }
        }
      }
    },
